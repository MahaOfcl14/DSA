#include <bits/stdc++.h>
using namespace std;
long long maxSumProd(vector<int>& a, vector<int>& b) {
    int n = a.size();
       sort(a.begin(), a.end());
    sort(b.begin(), b.end());
    long long maxProdSum = 0;
        for (int i = 0; i < n; i++) {
        maxProdSum  += (long long)a[i] * b[i];
    }
    
    return maxProdSum;
}

int main() {
    vector<int> a = {1, 2, -7};
    vector<int> b = {-4, 3, 1};
    long long res = maxSumProd(a, b);
    cout <<res << endl;
    return 0;
}
