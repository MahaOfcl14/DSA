#include <bits/stdc++.h>
using namespace std;
long long miniSum(vector<int>& a, vector<int>& b) {
    int n = a.size();
     sort(a.begin(), a.end()); // ascending
    sort(b.begin(), b.end(), greater<int>()); // descending     
    long long minProdSum = 0;
        for (int i = 0; i < n; i++) {
        minProdSum += (long long)a[i] * b[i];
    }
    
    return minProdSum;
}

int main() {
    vector<int> a = {1, 2, -8};
    vector<int> b = {-6, 1, 2};
    
    long long res = miniSum(a, b);
    
    cout << res << endl;
    
    return 0;
}
