class Solution {
    bool isEqual(int mid, int n, int m) {
        long long res = 1;
        for (int i = 0; i < n; i++) {
            res *= mid;
            if (res > m) return false;
        }
        return res == m;
    }

public:
    int nthRoot(int n, int m) {
        int low = 1, high = m;
        while (low <= high) {
            int mid = (low + high) / 2;
            long long res = 1;
            for (int i = 0; i < n; i++) {
                res *= mid;
                if (res > m) break;
            }

            if (res == m) return mid;
            else if (res < m) low = mid + 1;
            else high = mid - 1;
        }
        return -1;
    }
};
 

